# ── Solana ────────────────────────────────────────────────────────────────
# Optional. A Helius/QuickNode devnet URL removes public-RPC rate limits.
# Falls back to https://api.devnet.solana.com when unset.
HELIUS_RPC_URL=

# ── AI reasoning layer ────────────────────────────────────────────────────
# Optional. Any ONE of these turns on real model reasoning for the agent's
# planner and the paid "summarize"/"brief" services. With none set, Stipend
# runs a deterministic planner so the demo can never break on a missing key.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which model to use when a key is present (defaults per provider).
LLM_MODEL=
