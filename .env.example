# ── Solana ────────────────────────────────────────────────────────────────
# Optional. A Helius/QuickNode devnet URL removes public-RPC rate limits and is
# strongly recommended for a deployed instance.
HELIUS_RPC_URL=

# ── AI reasoning layer ────────────────────────────────────────────────────
# Server-only. Never expose this with a NEXT_PUBLIC_ prefix: it is read inside
# route handlers, and a public prefix would ship it to every browser.
# Without it the vendors fall back to a deterministic engine and say so.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model override. Defaults to deepseek-flash (DeepSeek V4.1 Flash).
LLM_MODEL=

# ── Persistence ───────────────────────────────────────────────────────────
# Optional but required for serverless hosts: a deployed instance has no
# writable disk, so wallet keys, agents and the ledger live in Redis.
# Create a free database at upstash.com and paste these two values.
# Locally, leave them blank and everything is stored in .devnet/.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel's Upstash integration injects these names instead; either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
